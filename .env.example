# =========================================================================
# NetVerify - Environment Variables Template (.env.example)
# =========================================================================
# Copy this file to '.env' and replace the placeholder values with your own.
# DO NOT commit the actual '.env' file to your Git repository.

# 1. Database Connection (PostgreSQL)
# Format: postgresql://username:password@host:port/database_name
# For local development:
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/telecom_db

# 2. Security and JWT Authentication
# Generate a secure secret key using: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_secure_random_hex_key_at_least_32_bytes

# 3. Network Ports & API URLs
# FastAPI backend URL (accessed by the Streamlit dashboard server-side)
NETVERIFY_API_URL=http://backend:8000
# FastAPI backend public URL (accessed by the user's browser client-side for widgets)
NETVERIFY_PUBLIC_API_URL=http://127.0.0.1:8000

# 4. Orchestration webhook (n8n integration)
# Webhook URL of n8n to trigger the verification pipeline
NETVERIFY_N8N_WEBHOOK=http://host.docker.internal:5678/webhook/netverify-verification
# Service authentication token to protect critical API endpoints
NETVERIFY_SERVICE_TOKEN=your_secure_service_token_here
